# Copy to `.env` for local development. Production deployments should source
# their values from a secret manager (Kubernetes Secret, Vault, systemd
# `LoadCredential`, …) rather than committing a `.env` file.

# Listen address. Use 0.0.0.0:8698 inside Docker.
SOLAND_BIND=127.0.0.1:8698

# Advertised base URL surfaced in `/_arkret/describe` and DID metadata.
SOLAND_PUBLIC_BASE_URL=http://127.0.0.1:8698
# Optional TLS. When both are set, soland starts a rustls HTTPS listener.
# For local testing, `mkcert local.host` produces the matching PEM files.
# SOLAND_TLS_CERT_PATH=./local.host.pem
# SOLAND_TLS_KEY_PATH=./local.host-key.pem

# The service identity is resolved from the durable service-identity record,
# Provider registration mapping, or a verified identity bundle. Development
# mode automatically provisions an identity for a fresh local database.
# For a first production boot without an external Provider, set this once and
# remove it after the first successful start:
# SOLAND_FIRST_PROVISIONING=1

# Runtime persistence requires DATABASE_URL and durable key custody. Use the
# native current-user credential store, or an encrypted file whose random
# 32-byte base64 master key is mounted and backed up separately. For local
# development, `just init-dev` creates the file below without overwriting an
# existing valid key.
# SOLAND_KEYSTORE_BACKEND=platform
# SOLAND_KEYSTORE_BACKEND=encrypted_file
# SOLAND_KEYSTORE_PATH=./.local/keystore/soland.v1
# SOLAND_KEYSTORE_MASTER_KEY_FILE=./.local/secrets/soland-keystore-master-key
# SOLAND_SERVICE_IDENTITY_BUNDLE_DIR=./.local/identity-bundle

# Built-in did:webvh identity provider. Enabled by default so coauth can offer
# this soland instance as the default registration provider. Set to false when
# all registration should go through an external provider.
SOLAND_EMBEDDED_WEBVH_PROVIDER_ENABLED=true
# Required when the embedded provider is enabled. Configure the same secret in
# coauth; only requests with `Authorization: Bearer <secret>` may write webvh
# registration records.
# SOLAND_EMBEDDED_WEBVH_REGISTRATION_BEARER=replace-with-secret
# Optional external did:webvh provider, for example a standalone did:webvh registrar.
# SOLAND_EXTERNAL_WEBVH_PROVIDER_URL=https://webvh.example
# Optional provider id to preselect in coauth: `soland.embedded` or `external.webvh`.
# SOLAND_DEFAULT_WEBVH_PROVIDER_ID=soland.embedded

# Production browser-session auth. Clients present a `ak.session.grant` + DPoP;
# soland verifies it by calling coauth's session-grant introspection endpoint
# with the shared service bearer below.
# SOLAND_SESSION_GRANT_INTROSPECTION_URL=http://coauth.internal:8080/_arkret/gate/account/session-grants/introspect
# SOLAND_SESSION_GRANT_INTROSPECTION_BEARER=shared-secret-known-by-coauth

# Production admin API allowlist. Comma-separated principal DIDs; when
# development mode is false and this is empty, the admin API is closed.
# Browser sessions are still validated through the introspection settings above.
# SOLAND_ADMIN_PRINCIPAL_DIDS=did:web:admin1.example,did:web:admin2.example

# Required by every runtime binary. In-memory persistence is reserved for tests.
# DATABASE_URL=postgres://soland:soland@localhost:5432/soland

# Object storage for blob uploads. Use `filesystem` for local development or
# `s3-compatible` for S3, MinIO, R2, or another S3 API implementation.
SOLAND_OBJECT_STORAGE_BACKEND=filesystem
# SOLAND_OBJECT_STORAGE_LOCAL_ROOT=/var/lib/soland/objects
# SOLAND_OBJECT_STORAGE_PREFIX=prod

# S3-compatible object storage:
# SOLAND_OBJECT_STORAGE_BACKEND=s3-compatible
# SOLAND_OBJECT_STORAGE_S3_BUCKET=soland
# SOLAND_OBJECT_STORAGE_S3_REGION=us-east-1
# SOLAND_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# SOLAND_OBJECT_STORAGE_S3_ACCESS_KEY_ID=change-me
# SOLAND_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# SOLAND_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
# SOLAND_OBJECT_STORAGE_S3_ALLOW_HTTP=false
# SOLAND_OBJECT_STORAGE_S3_SESSION_TOKEN=change-me
# Test-only object stores may require unsigned requests. Do not enable for production S3.
# SOLAND_OBJECT_STORAGE_S3_SKIP_SIGNATURE=false

# Single browser origin allowed by CORS. Leave unset to disable CORS.
# SOLAND_CORS_ALLOW_ORIGIN=http://localhost:5173
# Public Account Authority base URL advertised through /_arkret/describe.
# Browser registration, recovery, and session-grant issuance call this service,
# not soland.
# SOLAND_ACCOUNT_AUTHORITY_URL=https://auth.local.host
# OAuth/OIDC client_id this soland is registered as at the Auth Server,
# advertised in describe.auth_metadata.methods[].oidc.client_id. coauth keys
# clients by ULID, so set this to the registered client id (not a human alias).
# SOLAND_OAUTH_CLIENT_ID=01GFWR28C4KNE04WG3HKXB7C9R

# Defaults to `false`. Set to `true` only for local development; this enables
# `dev_login`, the admin snapshot endpoints, and a relaxed DID-document
# validation path.
SOLAND_DEVELOPMENT_MODE=true

# Development-only fault injection for crash-consistency tests. Parsed once at
# startup and always empty unless development mode is on; an unknown failpoint
# id is a startup error, never a silently inert failpoint.
# SOLAND_FAILPOINTS=backup_series_erase_durable_step=fail_after_durable_steps:1

# Security and trust posture.
SOLAND_TRUST_DOMAIN=ak:trust_domain:local.host
# SOLAND_DID_RESOLVER_ALLOW_METHODS=web,key,uuid
# SOLAND_JWS_REPLAY_WINDOW_SECONDS=300
# SOLAND_KEY_BACKUP_DAILY_DOWNLOAD_LIMIT=100
# Outbound requests reject private/link-local destinations by default outside
# development mode. The allow-private switch is authoritative and dangerous;
# prefer an explicit allowlist and denylist in production.
# SOLAND_EGRESS_ALLOW_PRIVATE_NETWORKS=false
# SOLAND_EGRESS_ALLOWED_HOSTS=api.example,*.trusted.example
# SOLAND_EGRESS_DENYLIST=metadata.internal,169.254.169.254
# SOLAND_FEDERATION_DENYLIST=blocked.example
# SOLAND_FEDERATION_PEER_DENYLIST=did:web:blocked.example
# Claim the `ak.profile.candidate.join_policy.v1` candidate profile and expose
# the product-local join-policy member-application read surface
# (GET /_soland/self/realms/{realm_id}/applications). Fail-closed (404) by
# default; `member.application` is a spec candidate concept kept off the
# /_arkret/* protocol root until formally registered.
# SOLAND_CANDIDATE_JOIN_POLICY=false

# External webvh provider probe expectations.
# SOLAND_EXTERNAL_WEBVH_PROVIDER_TRUST_DOMAIN=ak:trust_domain:webvh.example

# Federation and push bridge.
# SOLAND_FEDERATION_FANOUT_TOPOLOGY=mesh
# SOLAND_FEDERATION_PEERS=https://peer-a.example,https://peer-b.example
# SOLAND_FEDERATION_OUTBOUND=true
# SOLAND_PUSH_BRIDGE_CACHE_TTL_SECS=900
# SOLAND_PUSH_BRIDGE_TRUSTED_SERVICE_IDS=did:web:push.example

# Admin pagination.
# SOLAND_ADMIN_PAGE_LIMIT=100
# SOLAND_ADMIN_MAX_PAGE_LIMIT=1000

# Upload staging.
# SOLAND_RESUMABLE_UPLOAD_DIR=./soland-resumable-uploads
# SOLAND_RESUMABLE_UPLOAD_TTL_SECS=86400

# Anchor compaction pruning.
# SOLAND_COMPACTION_MIN_SEAL_AGE_SECS=604800
# SOLAND_COMPACTION_MIN_WITNESSES=1
# SOLAND_COMPACTION_PRESERVE_GENESIS=true
# SOLAND_COMPACTION_PRUNE_ONLY_SINGLETON_SUCCESSORS=true
# SOLAND_COMPACTION_PRUNE_WALK_INTERVAL_SECS=0
# SOLAND_COMPACTION_PRUNE_WALK_PER_REALM_LIMIT=50

# Sovereign enclave profile.
# SOLAND_SOVEREIGN_ENCLAVE=false
# SOLAND_SOVEREIGN_ENCLAVE_ALLOWED_OUTBOUND_HOSTS=webvh.example,coauth.example

# Verified conformance profile advertisement.
# SOLAND_VERIFIED_PROFILES_ARTIFACT=../cotest/artifacts/verified-profiles.json
# The test-only /_arkret/_conformance/* namespace (service-http-binding.md
# §2.1.2) is gated on the ak.profile.conformance_harness.v1 build profile, which
# is active iff SOLAND_DEVELOPMENT_MODE=true. There is no separate enable flag;
# production deployments (development_mode=false) return 404 for that namespace.

# Optional receive-policy constraints advertised in ServiceDescribe. CSV
# values are trimmed; omitting every variable leaves the constraint absent.
# SOLAND_RECEIVE_POLICY_APPLIES_TO=invite_delivery,contact_request
# SOLAND_RECEIVE_POLICY_PERMITTED_INTRODUCTION_KINDS=handle_claim,explicit_address
# SOLAND_RECEIVE_POLICY_FORBIDDEN_INTRODUCTION_KINDS=
# SOLAND_RECEIVE_POLICY_HANDLE_CLAIM_MAX_BEHAVIOR=notify
# SOLAND_RECEIVE_POLICY_EXPLICIT_ADDRESS_MAX_BEHAVIOR=quarantine
# SOLAND_RECEIVE_POLICY_UNKNOWN_INVITES_MAX_BEHAVIOR=drop
# SOLAND_RECEIVE_POLICY_ALLOWED_HANDLE_DOMAINS=example.org
# SOLAND_RECEIVE_POLICY_TRUSTED_HANDLE_ISSUERS=did:web:issuer.example
# SOLAND_RECEIVE_POLICY_TRUSTED_DIRECTORY_SERVICES=did:web:directory.example
# SOLAND_RECEIVE_POLICY_TRUSTED_PRINCIPAL_SERVICES=did:web:principal.example
# SOLAND_RECEIVE_POLICY_BLOCKED_PRINCIPAL_SERVICES=did:web:blocked.example
# SOLAND_RECEIVE_POLICY_ACCEPTED_SUBJECT_DID_METHODS=web,webvh,key

# Runtime resource bounds and shutdown behavior.
# SOLAND_TO_DEVICE_QUEUE_CAPACITY=10000
# SOLAND_SHUTDOWN_GRACE_SECS=30
# SOLAND_DB_POOL_MAX_SIZE=32
# SOLAND_DB_POOL_ACQUIRE_TIMEOUT_SECS=30
# Test/demo data is opt-in and must stay disabled in production.
# SOLAND_SEED_DEMO_DATA=false

# Rate limiter ceilings (requests per window, per remote address, per class).
# Production defaults: probe=600, auth=60, api=300, other=600 over a 60s window;
# development_mode lifts every class far above a human's request rate so the
# shared loopback bucket does not trip 429 during local dev. The advertised
# describe `rate_limit_policy` always reflects these effective values.
# SOLAND_RATE_LIMIT_WINDOW_SECONDS=60
# SOLAND_RATE_LIMIT_DEFAULT_PER_MINUTE=600
# SOLAND_RATE_LIMIT_AUTH_PER_MINUTE=60
# SOLAND_RATE_LIMIT_API_PER_MINUTE=300
# SOLAND_RATE_LIMIT_PROBE_PER_MINUTE=600

# Proxy and healthcheck helpers.
# SOLAND_RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
# SOLAND_HEALTHCHECK_URL=http://127.0.0.1:8698/readyz

# tracing-subscriber filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=soland=debug,salvo=info,warn
RUST_LOG=soland=info
