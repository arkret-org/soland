# Copy to `.env` for local development. Production deployments should source
# their values from a secret manager (Kubernetes Secret, Vault, systemd
# `LoadCredential`, …) rather than committing a `.env` file.

# Listen address. Use 0.0.0.0:8787 inside Docker.
SERVERX_BIND=127.0.0.1:8787

# Advertised base URL surfaced in `/api/v1/server/describe` and DID metadata.
SERVERX_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Service DID — the principal-server identity. Proof `audience` bindings
# reject anything that doesn't match this exact value.
SERVERX_SERVICE_DID=did:web:soland.local

# Optional. Without a database soland runs in-memory.
# DATABASE_URL=postgres://soland:soland@localhost:5432/soland

# Filesystem root for blob uploads. Must exist and be writable by the soland
# process; production should be a dedicated persistent volume, not the
# system temp directory.
# SERVERX_BLOB_ROOT=/var/lib/soland/blobs

# Single browser origin allowed by CORS. Leave unset to disable CORS.
# SERVERX_CORS_ALLOW_ORIGIN=http://localhost:5173

# Defaults to `false`. Set to `true` only for local development; this enables
# `dev_login`, the admin snapshot endpoints, and a relaxed DID-document
# validation path.
SERVERX_DEVELOPMENT_MODE=true

# tracing-subscriber filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=soland=debug,salvo=info,warn
RUST_LOG=soland=info
