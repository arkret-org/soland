# Copy to `.env` for local development. Production deployments should source
# their values from a secret manager (Kubernetes Secret, Vault, systemd
# `LoadCredential`, …) rather than committing a `.env` file.

# Listen address. Use 0.0.0.0:8698 inside Docker.
SOLAND_BIND=127.0.0.1:8698

# Advertised base URL surfaced in `/_cokret/describe` and DID metadata.
SOLAND_PUBLIC_BASE_URL=http://127.0.0.1:8698
# Optional TLS. When both are set, soland starts a rustls HTTPS listener.
# For local testing, `mkcert local.host` produces the matching PEM files.
# SOLAND_TLS_CERT_PATH=./local.host.pem
# SOLAND_TLS_KEY_PATH=./local.host-key.pem

# Service DID — the principal-server identity. Proof `audience` bindings
# reject anything that doesn't match this exact value.
SOLAND_SERVICE_DID=did:web:local.host

# Built-in did:webvh identity provider. Enabled by default so coauth can offer
# this soland instance as the default registration provider. Set to false when
# all registration should go through an external provider.
SOLAND_EMBEDDED_WEBVH_PROVIDER_ENABLED=true
# Required when the embedded provider is enabled. Configure the same secret in
# coauth; only requests with `Authorization: Bearer <secret>` may write webvh
# registration records.
# SOLAND_EMBEDDED_WEBVH_REGISTRATION_BEARER=replace-with-secret
# Optional external did:webvh provider, for example a standalone StarID service.
# SOLAND_EXTERNAL_WEBVH_PROVIDER_URL=https://webvh.example
# Optional provider id to preselect in coauth: `soland.embedded` or `external.webvh`.
# SOLAND_DEFAULT_WEBVH_PROVIDER_ID=soland.embedded

# Production auth, Matrix/Palpo style. Clients send coauth OAuth access tokens
# directly to soland as `Authorization: Bearer ...`; soland verifies them by
# calling this introspection endpoint with the shared service bearer below.
# SOLAND_OAUTH_INTROSPECTION_URL=http://coauth.internal:8080/oauth2/introspect
# SOLAND_OAUTH_INTROSPECTION_BEARER=shared-secret-known-by-coauth
# Optional session-grant introspection bridge.
# SOLAND_SESSION_GRANT_INTROSPECTION_URL=http://coauth.internal:8080/_cokret/gate/account/session-grants/introspect
# SOLAND_SESSION_GRANT_INTROSPECTION_BEARER=shared-secret-known-by-coauth

# Optional. Without a database soland runs in-memory.
# DATABASE_URL=postgres://soland:soland@localhost:5432/soland

# Object storage for blob uploads. Use `filesystem` for local development or
# `s3-compatible` for S3, MinIO, R2, or another S3 API implementation.
SOLAND_OBJECT_STORAGE_BACKEND=filesystem
# SOLAND_OBJECT_STORAGE_LOCAL_ROOT=/var/lib/soland/objects
# SOLAND_OBJECT_STORAGE_PREFIX=prod

# S3-compatible object storage:
# SOLAND_OBJECT_STORAGE_BACKEND=s3-compatible
# SOLAND_OBJECT_STORAGE_S3_BUCKET=soland
# SOLAND_OBJECT_STORAGE_S3_REGION=us-east-1
# SOLAND_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# SOLAND_OBJECT_STORAGE_S3_ACCESS_KEY_ID=change-me
# SOLAND_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# SOLAND_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
# SOLAND_OBJECT_STORAGE_S3_ALLOW_HTTP=false
# SOLAND_OBJECT_STORAGE_S3_SESSION_TOKEN=change-me
# Test-only object stores may require unsigned requests. Do not enable for production S3.
# SOLAND_OBJECT_STORAGE_S3_SKIP_SIGNATURE=false

# Single browser origin allowed by CORS. Leave unset to disable CORS.
# SOLAND_CORS_ALLOW_ORIGIN=http://localhost:5173
# Public Auth / Account Server base URL advertised through /_cokret/describe.
# Browser registration and recovery strands call this service, not soland.
# SOLAND_AUTH_SERVER_URL=https://auth.local.host

# Defaults to `false`. Set to `true` only for local development; this enables
# `dev_login`, the admin snapshot endpoints, and a relaxed DID-document
# validation path.
SOLAND_DEVELOPMENT_MODE=true

# Security and trust posture.
# SOLAND_TRUST_DOMAIN=ck:trust_domain:local.host
# SOLAND_DID_RESOLVER_ALLOW_METHODS=web,key,uuid
# SOLAND_JWS_REPLAY_WINDOW_SECONDS=300
# SOLAND_ACCOUNTABLE_PRINCIPALS_STRICT_REJECT=false
# SOLAND_MEDIA_SERVICE_LEGACY_REJECT=false
# SOLAND_KEY_BACKUP_DAILY_DOWNLOAD_LIMIT=100
# SOLAND_AGENT_AUDIT_BINDING_SIGNING_SEED=base64-32-byte-seed

# External webvh provider probe expectations.
# SOLAND_EXTERNAL_WEBVH_PROVIDER_SERVICE_DID=did:web:webvh.example
# SOLAND_EXTERNAL_WEBVH_PROVIDER_TRUST_DOMAIN=ck:trust_domain:webvh.example

# Federation and push bridge.
# SOLAND_FEDERATION_POLICY=mesh
# SOLAND_FEDERATION_PEERS=https://peer-a.example,https://peer-b.example
# SOLAND_FEDERATION_OUTBOUND=true
# SOLAND_ERASURE_PROPAGATION_WINDOW_MS=604800000
# SOLAND_PUSH_BRIDGE_CACHE_TTL_SECS=900
# SOLAND_PUSH_BRIDGE_TRUSTED_SERVICE_DIDS=did:web:push.example

# Admin pagination.
# SOLAND_ADMIN_PAGE_LIMIT=100
# SOLAND_ADMIN_MAX_PAGE_LIMIT=1000

# Upload staging.
# SOLAND_RESUMABLE_UPLOAD_DIR=./soland-resumable-uploads
# SOLAND_RESUMABLE_UPLOAD_TTL_SECS=86400

# Anchor compaction pruning.
# SOLAND_COMPACTION_MIN_ANCHOR_AGE_SECS=604800
# SOLAND_COMPACTION_MIN_WITNESSES=1
# SOLAND_COMPACTION_PRESERVE_GENESIS=true
# SOLAND_COMPACTION_PRUNE_ONLY_SINGLETON_SUCCESSORS=true
# SOLAND_COMPACTION_PRUNE_WALK_INTERVAL_SECS=0
# SOLAND_COMPACTION_PRUNE_WALK_PER_REALM_LIMIT=50

# Sovereign enclave profile.
# SOLAND_SOVEREIGN_ENCLAVE=false
# SOLAND_SOVEREIGN_ENCLAVE_ALLOWED_OUTBOUND_HOSTS=webvh.example,coauth.example

# Verified conformance profile advertisement and local conformance helpers.
# SOLAND_VERIFIED_PROFILES_ARTIFACT=../cotest/artifacts/verified-profiles.json
# SOLAND_ENABLE_CONFORMANCE_ENDPOINTS=false
# SOLAND_PROFILE_STATELESS_CURSOR=false

# Proxy and healthcheck helpers.
# SOLAND_RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
# SOLAND_TRUST_X_FORWARDED_FOR=false
# SOLAND_HEALTHCHECK_URL=http://127.0.0.1:8698/readyz

# tracing-subscriber filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=soland=debug,salvo=info,warn
RUST_LOG=soland=info
