(dev_cors) {
	@has_origin header Origin *
	header @has_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Credentials "true"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
		Access-Control-Allow-Headers "authorization, content-type, idempotency-key, x-cokret-request-id, x-cokret-wait-for, x-cokret-content-digest, x-cokret-realm-id, x-cokret-filename, x-cokret-blob-encrypted, x-cokret-blob-purpose, x-cokret-purpose, x-cokret-attachment-envelope, x-cokret-key-backup-delete-proof, x-cokret-key-backup-unlock-proof, range"
		Access-Control-Expose-Headers "retry-after, x-cokret-wait-for-satisfied, content-range, accept-ranges"
		Vary "Origin"
		defer
	}

	@preflight method OPTIONS
	respond @preflight "" 204
}

(dev_error_cors) {
	handle_errors {
		@error_has_origin header Origin *
		header @error_has_origin {
			Access-Control-Allow-Origin "{http.request.header.Origin}"
			Access-Control-Allow-Credentials "true"
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"
			Access-Control-Allow-Headers "authorization, content-type, idempotency-key, x-cokret-request-id, x-cokret-wait-for, x-cokret-content-digest, x-cokret-realm-id, x-cokret-filename, x-cokret-blob-encrypted, x-cokret-blob-purpose, x-cokret-purpose, x-cokret-attachment-envelope, x-cokret-key-backup-delete-proof, x-cokret-key-backup-unlock-proof, range"
			Access-Control-Expose-Headers "retry-after, x-cokret-wait-for-satisfied, content-range, accept-ranges"
			Vary "Origin"
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

https://local.host:443 {
	tls internal
	import dev_cors
	import dev_error_cors

	reverse_proxy 127.0.0.1:8698
}

https://auth.local.host:443 {
	tls internal
	import dev_cors
	import dev_error_cors
	reverse_proxy 127.0.0.1:7080
}
