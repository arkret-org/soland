# Copy to `.env` for local development. Production deployments should source
# their values from a secret manager (Kubernetes Secret, Vault, systemd
# `LoadCredential`, …) rather than committing a `.env` file.

# Listen address. Use 0.0.0.0:8698 inside Docker.
SOLAND_BIND=127.0.0.1:8698

# Advertised base URL surfaced in `/_arkret/describe` and DID metadata.
SOLAND_PUBLIC_BASE_URL=https://local.host
# SOLAND_TLS_CERT_PATH=./local.host.pem
# SOLAND_TLS_KEY_PATH=./local.host-key.pem

# The service identity is resolved from durable state. Development mode
# automatically provisions an identity for a fresh local database.
SOLAND_KEYSTORE_BACKEND=encrypted_file
SOLAND_KEYSTORE_PATH=./.local/keystore/soland.v1
SOLAND_KEYSTORE_MASTER_KEY_FILE=C:/Users/chris/.arkret/secrets/soland-keystore-master-key
SOLAND_SERVICE_IDENTITY_BUNDLE_DIR=./.local/identity-bundle

# Optional. Without a database soland runs in-memory.
DATABASE_URL=postgres://postgres:root@localhost:5432/soland_dev

# Built-in did:webvh identity provider. Enabled by default so coauth can offer
# this soland instance as the default registration provider. Set to false when
# all registration should go through an external provider.
SOLAND_EMBEDDED_WEBVH_PROVIDER_ENABLED=true
SOLAND_EMBEDDED_WEBVH_REGISTRATION_BEARER=local-soland-webvh-registration
# Optional external did:webvh provider, for example a standalone StarID service.
# SOLAND_EXTERNAL_WEBVH_PROVIDER_URL=https://webvh.example
# Optional provider id to preselect in coauth: `soland.embedded` or `external.webvh`.
# SOLAND_DEFAULT_WEBVH_PROVIDER_ID=soland.embedded

# coauth delegated auth for local development.
SOLAND_OAUTH_INTROSPECTION_URL=https://auth.local.host/oauth/introspect
SOLAND_OAUTH_INTROSPECTION_BEARER=local-coauth-oauth-introspection
SOLAND_SESSION_GRANT_INTROSPECTION_URL=https://auth.local.host/_arkret/gate/account/session-grants/introspect
SOLAND_SESSION_GRANT_INTROSPECTION_BEARER=local-coauth-session-grant-introspection

# Object storage for blob uploads. Use `filesystem` for local testing or
# `s3-compatible` for S3, MinIO, R2, or another S3 API implementation.
SOLAND_OBJECT_STORAGE_BACKEND=filesystem
SOLAND_OBJECT_STORAGE_LOCAL_ROOT=../testdata
# SOLAND_OBJECT_STORAGE_PREFIX=prod

# S3-compatible object storage:
# SOLAND_OBJECT_STORAGE_BACKEND=s3-compatible
# SOLAND_OBJECT_STORAGE_S3_BUCKET=soland
# SOLAND_OBJECT_STORAGE_S3_REGION=us-east-1
# SOLAND_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
# SOLAND_OBJECT_STORAGE_S3_ACCESS_KEY_ID=change-me
# SOLAND_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# SOLAND_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
# SOLAND_OBJECT_STORAGE_S3_ALLOW_HTTP=false

# Single browser origin allowed by CORS. Leave unset to disable CORS.
# SOLAND_CORS_ALLOW_ORIGIN=http://localhost:5173
SOLAND_ACCOUNT_AUTHORITY_URL=https://auth.local.host
SOLAND_ACCOUNT_AUTHORITY_ENROLLMENT_DID=did:key:z6Mkfmm57fsb6VL7zVusP8zeA9SYkCKdvUhby2G7Yh8vvQ1P
# OAuth/OIDC client_id this soland is registered as at coauth, advertised in
# describe.auth_metadata.methods[].oidc.client_id. coauth keys clients by ULID,
# so this MUST equal the registered client id (coauth/config.dev.yaml "Yougen Dev").
SOLAND_OAUTH_CLIENT_ID=01GFWR28C4KNE04WG3HKXB7C9R

# Defaults to `false`. Set to `true` only for local development; this enables
# `dev_login`, the admin snapshot endpoints, and a relaxed DID-document
# validation path.
SOLAND_DEVELOPMENT_MODE=true

# tracing-subscriber filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=soland=debug,salvo=info,warn
RUST_LOG=soland=info
